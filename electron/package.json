{
  "name": "fluxone-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "POS Cashier — Software Flux Solution (Electron Phase 4)",
  "author": "Software Flux Solution",
  "main": "src/main.js",
  "type": "commonjs",
"scripts": {
  "dev": "cross-env NODE_ENV=development electron .",
  "dev:staging": "cross-env NODE_ENV=staging electron .",
  "dev:prod": "cross-env NODE_ENV=production electron .",
  "build": "electron-builder",
  "dist": "node scripts/prepare-dist.mjs && electron-builder --win",
  "pack": "node scripts/prepare-dist.mjs && electron-builder --dir"
},
  "build": {
    "appId": "com.softwareflux.fluxone.pos",
    "productName": "FluxOne",
    "copyright": "Copyright © Software Flux Solution",
    "afterPack": "./scripts/after-pack.cjs",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config",
        "to": "config",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!**/.env",
          "!**/.env.*",
          "!**/data/*.db",
          "!**/data/*.db-*",
          "!**/scripts/**",
          "!**/node_modules/fluxone",
          "!**/node_modules/fluxone/**",
          "!**/node_modules/nodemon/**",
          "!**/node_modules/.cache/**"
        ]
      },
      {
        "from": "../client/dist",
        "to": "client-dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/nodejs",
        "to": "nodejs",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FluxOne-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "POS Cashier",
      "uninstallDisplayName": "POS Cashier — Software Flux Solution"
    },
    "asar": true
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "html-to-image": "^1.11.13"
  }
}
