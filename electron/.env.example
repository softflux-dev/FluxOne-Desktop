# FluxOne desktop (Electron) — copy to electron/.env
# Never commit real secrets. Packaged builds default DISABLE_DEVTOOLS=YES.

# YES = DevTools / inspect shortcuts / casual text-select OFF (deterrence only)
# NO  = DevTools ON (use while developing so you can read logs / errors)
FLUXONE_DISABLE_DEVTOOLS=NO

# Preferred local API port. If busy, splash finds the next free port automatically.
# FLUXONE_API_PORT=3000
