# FluxOne POS — server environment template
# Copy to server/.env and fill in real values. Never commit server/.env.

PORT=3000
NODE_ENV=development

# SQLite file path (relative to server/ working directory)
SQLITE_PATH=./data/fluxone.db

# REQUIRED in any shared / production install — use a long random string
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=24h

AUTH_TTL_HOURS=24
IDLE_MINUTES=15
VARIANCE_PIN_THRESHOLD=500

# Local network gate for sync (true = online, false = force offline)
NETWORK_ONLINE=true

# Comma-separated browser origins (prefer 127.0.0.1 for Vite + cookie SameSite)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000

# Force Secure cookies (needs HTTPS). Leave false for local http:// Vite + API.
# When true, auth cookie uses SameSite=None (cross-site HTTPS only).
COOKIE_SECURE=false

# Optional: absolute path to client/dist when Electron serves the UI
# CLIENT_DIST_PATH=
